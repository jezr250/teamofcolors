generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  email     String
  phone     String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}
